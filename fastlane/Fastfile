# StremioTV — livraison TestFlight (tests internes uniquement).
#
# Authentification : clé App Store Connect API (.p8) fournie en base64 via
# variable d'environnement — non interactif, sans 2FA (adapté à la CI).
# Signature : automatique + `-allowProvisioningUpdates` (certificats/profils
# « cloud-managed » créés et réutilisés par Xcode via la clé API — aucun dépôt
# de certificats à maintenir).
#
# Variables d'environnement attendues :
#   ASC_KEY_ID          identifiant de la clé API
#   ASC_ISSUER_ID       identifiant de l'émetteur (Issuer ID)
#   ASC_KEY_P8_BASE64   contenu du fichier .p8 encodé en base64
#   APPLE_TEAM_ID       identifiant d'équipe Apple Developer (10 caractères)
# Optionnelles :
#   BUILD_NUMBER        numéro de build (ex. numéro de run CI) — défaut 1
#   MARKETING_VERSION   version marketing (ex. 0.2.0, ou tag "v0.2.0")

IOS_SCHEME  = "StremioTV-iOS"
TVOS_SCHEME = "StremioTV"
IOS_APP_ID  = ENV["IOS_BUNDLE_ID"]  || "com.nicolasbataille.stremiotv"
TVOS_APP_ID = ENV["TVOS_BUNDLE_ID"] || "com.nicolasbataille.stremiotv.tv"
TEAM_ID     = ENV["APPLE_TEAM_ID"]

# Version marketing : accepte "0.2.0" ou "v0.2.0" (tag git). Toute valeur non
# conforme (ex. nom de branche "main" sur un run manuel) retombe sur le défaut,
# car CFBundleShortVersionString doit être 1 à 3 entiers séparés par des points.
raw_marketing     = (ENV["MARKETING_VERSION"] || "0.2.0").sub(/^v/, "")
MARKETING_VERSION = raw_marketing =~ /\A\d+(\.\d+){0,2}\z/ ? raw_marketing : "0.2.0"
BUILD_NUMBER      = ENV["BUILD_NUMBER"] || "1"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true,
    in_house: false
  )
end

# Compile une cible et l'envoie sur TestFlight (groupe de test interne).
def build_and_ship(scheme:, app_identifier:, api_key:)
  setup_ci # crée un trousseau temporaire en CI (no-op en local)

  build_app(
    scheme: scheme,
    export_method: "app-store",
    api_key: api_key,
    output_directory: "build",
    output_name: "#{scheme}.ipa",
    xcargs: [
      "-allowProvisioningUpdates",
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      "MARKETING_VERSION=#{MARKETING_VERSION}",
      "CURRENT_PROJECT_VERSION=#{BUILD_NUMBER}"
    ].join(" "),
    export_options: {
      method: "app-store",
      teamID: TEAM_ID,
      signingStyle: "automatic"
    }
  )

  upload_to_testflight(
    api_key: api_key,
    app_identifier: app_identifier,
    distribute_external: false,          # tests INTERNES uniquement
    skip_submission: true,               # pas de soumission App Store
    skip_waiting_for_build_processing: true
  )
end

platform :ios do
  desc "iPhone/iPad → TestFlight (tests internes)"
  lane :beta_ios do
    build_and_ship(scheme: IOS_SCHEME, app_identifier: IOS_APP_ID, api_key: asc_api_key)
  end

  desc "Apple TV → TestFlight (tests internes)"
  lane :beta_tvos do
    build_and_ship(scheme: TVOS_SCHEME, app_identifier: TVOS_APP_ID, api_key: asc_api_key)
  end

  desc "iPhone/iPad + Apple TV → TestFlight"
  lane :beta do
    key = asc_api_key
    build_and_ship(scheme: IOS_SCHEME,  app_identifier: IOS_APP_ID,  api_key: key)
    build_and_ship(scheme: TVOS_SCHEME, app_identifier: TVOS_APP_ID, api_key: key)
  end

  desc "Enregistre (une fois) les deux fiches d'app dans App Store Connect"
  lane :register_apps do
    key = asc_api_key
    produce(app_identifier: IOS_APP_ID,  app_name: "StremioTV",        api_key: key, platforms: ["ios"])
    produce(app_identifier: TVOS_APP_ID, app_name: "StremioTV Apple TV", api_key: key, platforms: ["tvos"])
  end
end
